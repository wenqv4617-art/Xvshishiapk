    val nodejsMobileAar = file("libs/nodejs-mobile-0.4.4.aar")
    if (nodejsMobileAar.exists()) {
        implementation(files(nodejsMobileAar))
    } else {
        implementation("com.github.nodejs-mobile:nodejs-mobile:0.4.4")
    }
}
